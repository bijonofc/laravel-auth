{
    "name": "bijon/laravel-auth",
    "description": "Authentication integrations for Laravel: Google OAuth2 and Cloudflare Turnstile.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "authentication", "oauth", "google", "turnstile", "captcha"],
    "authors": [
        { "name": "Bijan Kanti Munshi" }
    ],
    "require": {
        "php": "^8.3",
        "composer/ca-bundle": "^1.5",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "Bijon\\LaravelAuth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Bijon\\LaravelAuth\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Bijon\\LaravelAuth\\Providers\\AuthServiceProvider"],
            "aliases": {
                "GoogleOAuth": "Bijon\\LaravelAuth\\Facades\\GoogleOAuth",
                "Turnstile": "Bijon\\LaravelAuth\\Facades\\Turnstile"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
